# Copy these into Railway → your service → Variables.

# DEVELOPER login (you — the platform owner, top of everything). Sign in at /dev
DEV_EMAIL=mathewadvisement@gmail.com
DEV_PASSWORD=change-this-to-something-strong
DEV_NAME=Mathew Youhanna
PLATFORM_BRAND=Meridian OS

# Storage — point at a Railway Volume mount so nothing is lost on redeploy.
DATA_DIR=/data

# Fallback corporate landing page for off-boarded agents (each agency can set its own too).
CORP_LANDING_URL=https://meridianlife.example.com

# --- Lead alerts (all optional; leave blank to disable a channel) ---
# EMAIL — easiest automatic option: your own Gmail (sends to anyone, no third-party verification).
#   Needs a Google App Password (Google account must have 2-Step Verification on).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# (Generic SMTP alternative instead of Gmail:)
# SMTP_HOST=  SMTP_PORT=465  SMTP_USER=  SMTP_PASS=
#
# EMAIL — Brevo (free: verify one sender email, no domain needed).
BREVO_API_KEY=
ALERT_EMAIL_FROM=Meridian <youremail@gmail.com>
# (Alternatively, Resend instead of Brevo:)
RESEND_API_KEY=
# TEXT — two ways:
#  (a) FREE carrier gateways: set each agent's carrier in the dashboard; nothing to add here.
#  (b) Twilio (paid, ~1c/text) — if set, used instead of gateways:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# Optional copies of every alert to you:
OWNER_ALERT_EMAIL=
# For a copy by text, use your phone's gateway address (e.g. 5551234567@vtext.com) or a Twilio number:
OWNER_ALERT_SMS=

# PORT is set by Railway automatically — do not set it.
# INSECURE_COOKIES=1 only for local http testing.
