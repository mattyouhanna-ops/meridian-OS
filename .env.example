# Copy these into Railway → your service → Variables.
# All are optional except that you SHOULD set a strong OWNER_PASSWORD.

# Your owner login (the master dashboard)
OWNER_EMAIL=mathewadvisement@gmail.com
OWNER_PASSWORD=change-this-to-something-strong
OWNER_NAME=Mathew Youhanna
OWNER_BRAND=Meridian Life Group

# Where data is stored. Point this at a Railway Volume mount (e.g. /data) so nothing is lost on redeploy.
DATA_DIR=/data

# PORT is provided automatically by Railway — do not set it yourself.
# Leave cookies secure in production. Only set INSECURE_COOKIES=1 for local http testing.
