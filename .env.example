# Copy these into Railway → your service → Variables.

# DEVELOPER login (you — the platform owner, top of everything). Sign in at /dev
DEV_EMAIL=mathewadvisement@gmail.com
DEV_PASSWORD=change-this-to-something-strong
DEV_NAME=Mathew Youhanna
PLATFORM_BRAND=Meridian OS

# Storage — point at a Railway Volume mount so nothing is lost on redeploy.
DATA_DIR=/data

# Fallback corporate landing page for off-boarded agents (each agency can set its own too).
CORP_LANDING_URL=https://meridianlife.example.com

# --- Optional: lead alerts (leave blank to disable a channel) ---
# Email (Resend):
RESEND_API_KEY=
ALERT_EMAIL_FROM=Meridian <alerts@yourdomain.com>
# Text (Twilio):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
# Optional copies of every alert to you:
OWNER_ALERT_EMAIL=
OWNER_ALERT_SMS=

# PORT is set by Railway automatically — do not set it.
# INSECURE_COOKIES=1 only for local http testing.
